{
  "manifest_version": 3,
  "name": "Shift: Fix Hebrew/English keyboard mistakes",
  "version": "1.1.1",
  "description": "Typing English, getting Hebrish (Eמעךןדי)? Select, type <shift>, FIXED!\nהקלדתם עברית וקיבלתם אנגלית? סמנו את הטקסט, הקישו שיפט ונתקן",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
  ,
  "web_accessible_resources": [
    {
      "resources": ["mappings/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
  ,
  "icons": {
    "16": "shift16.png",
    "32": "shift32.png",
    "48": "shift48.png",
    "128": "shift128.png"
  }
}