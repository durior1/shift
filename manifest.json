{
  "manifest_version": 3,
  "name": "Shift - Fix Hebrew/English keyboard mistakes",
  "version": "0.1",
  "description": "Text came out in the wrong keyboard layout? Select it, tap <shift> and we'll fix it!\nהקלדתם במקלדת הלא נכונה? סמנו את הטקסט, הקישו Shift ונתקן את זה!",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "shift"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
  ,
  "web_accessible_resources": [
    {
      "resources": ["mappings/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
